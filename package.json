{
  "name": "card-window-root",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "bench": "pnpm --filter @annetaan/card-window bench",
    "build": "pnpm --filter @annetaan/card-window build",
    "ci": "pnpm run fix && pnpm run test",
    "coverage": "pnpm --filter @annetaan/card-window test --coverage",
    "docs:build": "pnpm build && pnpm --filter website build",
    "docs:check": "pnpm build && pnpm --filter website check",
    "docs:dev": "pnpm build && pnpm --filter website dev",
    "fix": "pnpm --filter @annetaan/card-window fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @annetaan/card-window test",
    "test:browser": "pnpm --filter @annetaan/card-window test:browser",
    "typecheck": "pnpm --filter @annetaan/card-window typecheck",
    "watch": "pnpm --filter @annetaan/card-window watch"
  }
}
