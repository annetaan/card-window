{
  "name": "@annetaan/card-window",
  "version": "1.10.3",
  "description": "Card window works by only rendering part of a large data set (just enough to fill the viewport). It is very much inspired by Brian Vaughn's react-window.",
  "keywords": [
    "react",
    "virtualize",
    "card",
    "list",
    "grid"
  ],
  "homepage": "https://github.com/annetaan/card-window",
  "bugs": {
    "url": "https://github.com/annetaan/card-window/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annetaan/card-window.git"
  },
  "license": "MIT",
  "author": "michiharu",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.mjs",
  "types": "./lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.mts",
        "default": "./lib/esm/index.mjs"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/lib"
  ],
  "scripts": {
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "fix": "oxlint --fix && npm run format && npx sort-package-json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "oxlint",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@testing-library/react": "^12.1.5",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^2.5.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=16.13.0 <19",
    "react-dom": ">=16.13.0 <19"
  },
  "publishConfig": {
    "access": "public"
  }
}
