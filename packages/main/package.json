{
  "name": "@annetaan/card-window",
  "version": "1.11.0",
  "description": "Card window works by only rendering part of a large data set (just enough to fill the viewport). It is very much inspired by Brian Vaughn's react-window.",
  "keywords": [
    "react",
    "virtualize",
    "card",
    "list",
    "grid"
  ],
  "homepage": "https://github.com/annetaan/card-window",
  "bugs": {
    "url": "https://github.com/annetaan/card-window/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annetaan/card-window.git"
  },
  "license": "MIT",
  "author": "michiharu",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.mjs",
  "types": "./lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.mts",
        "default": "./lib/esm/index.mjs"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/lib"
  ],
  "scripts": {
    "bench": "node bench/run.mts",
    "build": "tsdown",
    "coverage": "vitest run --project unit --coverage",
    "fix": "oxlint --fix && oxfmt && npx sort-package-json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepack": "npm run build",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": ">=16.13.0 <20",
    "react-dom": ">=16.13.0 <20"
  },
  "publishConfig": {
    "access": "public"
  }
}
