{
  "name": "@annetaan/card-window",
  "version": "1.10.3",
  "description": "Card window works by only rendering part of a large data set (just enough to fill the viewport). It is very much inspired by Brian Vaughn's react-window.",
  "keywords": [
    "react",
    "virtualize",
    "card",
    "list",
    "grid"
  ],
  "homepage": "https://github.com/annetaan/card-window",
  "bugs": {
    "url": "https://github.com/annetaan/card-window/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/annetaan/card-window.git"
  },
  "license": "MIT",
  "author": "michiharu",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.mjs",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.mts",
        "default": "./lib/esm/index.mjs"
      },
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/lib"
  ],
  "scripts": {
    "build": "rollup -c",
    "coverage": "jest --coverage",
    "fix": "npm run format && npm run lint && npx sort-package-json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint --fix --ext .ts,.tsx ./src",
    "postbuild": "node scripts/emit-mts-types.cjs",
    "prebuild": "rm -rf lib",
    "prepack": "npm run build",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "watch": "rollup -cw"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^12.1.2",
    "@types/jest": "^27.0.3",
    "@typescript-eslint/eslint-plugin": "^5.8.1",
    "@typescript-eslint/parser": "^5.8.1",
    "esbuild": "^0.14.9",
    "esbuild-jest": "^0.5.0",
    "eslint": "^8.6.0",
    "eslint-config-airbnb": "^19.0.2",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^2.5.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "jest": "^27.4.5",
    "prettier": "^2.5.1",
    "rollup": "^2.61.1",
    "rollup-plugin-typescript2": "^0.31.1",
    "tslib": "^2.3.1",
    "typescript": "^4.5.3"
  },
  "peerDependencies": {
    "react": ">=16.13.0 <19",
    "react-dom": ">=16.13.0 <19"
  },
  "publishConfig": {
    "access": "public"
  }
}
