---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code: string;
  title: string;
}

const { code, title } = Astro.props;
---

<!-- not-content keeps Starlight from adding a top margin to every card after the first. -->
<div class="not-content example"><slot /></div>
<Code code={code} lang="tsx" title={title} />

<style>
  .example {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem;
  }
</style>
