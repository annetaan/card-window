---
// Replaces Starlight's Hero: the logo and name, a headline, the page description, the actions,
// and an illustration of the windowing that shows on wide screens only.
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const columns = [2, 98, 194, 290];
// The middle three rows are in view and render; the rows above and below are only outlines.
const rows = [0, 1, 2, 3, 4].map((k) => ({ y: 2 + 76 * k, inside: k >= 1 && k <= 3 }));
---

<div class="hero">
  <div class="copy">
    <h1 id="_top" data-page-title class="brand">
      <img src={`${import.meta.env.BASE_URL}/logo.svg`} alt="" width="96" height="96" />
      <span set:html={title} />
    </h1>
    {tagline && <p class="headline" set:html={tagline} />}
    {data.description && <p class="lead">{data.description}</p>}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <svg class="illustration" viewBox="0 0 376 372" aria-hidden="true">
    {
      rows.map(({ y, inside }) =>
        columns.map((x) =>
          inside ? (
            <rect class="card" x={x} y={y} width="84" height="64" rx="9" />
          ) : (
            <rect class="ghost" x={x} y={y} width="84" height="64" rx="9" />
          ),
        ),
      )
    }
  </svg>
</div>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: 2rem;
    padding-bottom: 1rem;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    font-size: clamp(var(--sl-text-4xl), calc(0.5rem + 5vw), var(--sl-text-6xl));
    font-weight: 700;
    line-height: 1;
    color: var(--sl-color-white);
  }

  .brand img {
    width: 1.4em;
    height: 1.4em;
  }

  .headline {
    font-size: clamp(var(--sl-text-2xl), calc(0.5rem + 2.5vw), var(--sl-text-4xl));
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
  }

  .lead {
    max-width: 50ch;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .illustration {
    display: none;
  }

  .card {
    fill: #fff;
    fill-opacity: 0.1;
    stroke: #fff;
    stroke-opacity: 0.2;
    stroke-width: 1.5;
  }

  :global(:root[data-theme='light']) .card {
    fill-opacity: 1;
    stroke: var(--sl-color-gray-4);
    stroke-opacity: 1;
  }

  .ghost {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 2;
    stroke-dasharray: 6 5;
    opacity: 0.6;
  }

  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: 7fr 5fr;
      gap: 4%;
      padding-block: clamp(2.5rem, calc(1rem + 8vmin), 8rem);
    }

    .illustration {
      display: block;
      width: 100%;
      max-height: 28rem;
    }
  }
</style>
